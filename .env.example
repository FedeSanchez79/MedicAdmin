# ──────────────────────────────────────────────
# MedicAdmin — Variables de entorno
# Copiar a .env.local para desarrollo local.
# En Railway, configurar cada variable en el panel de entorno del servicio.
# ──────────────────────────────────────────────

# Ruta a la base de datos SQLite de MedicAdmin
# Railway: montar un volumen en /data y usar /data/medicadmin.db
# Local:   usar ruta relativa (se crea automáticamente)
ADMIN_DB_PATH=/data/medicadmin.db

# URLs de los servicios externos
MEDICDATA_URL=https://medicdata-production.up.railway.app
MEDICPROFESSIONALS_URL=https://medicprofessionals-production.up.railway.app

# Secreto compartido para autenticación entre MedicAdmin y las APIs externas
ADMIN_API_SECRET=medicadmin_secret_2026

# Secreto para firmar JWT de sesión (mínimo 32 caracteres)
JWT_SECRET=medicadmin_jwt_secret_2026

# Secreto para NextAuth (si se usa NextAuth)
NEXTAUTH_SECRET=medicadmin_nextauth_secret_2026

# Entorno de ejecución
NODE_ENV=production

# Puerto del servidor (Railway lo asigna automáticamente vía $PORT)
PORT=3002

# URL base de la aplicación (para links en emails, etc.)
APP_URL=https://medicadmin-production.up.railway.app

# Email del administrador (destinatario del link de recuperación de contraseña)
ADMIN_EMAIL=tu_email@gmail.com

# Cuenta Gmail desde la que se envían los emails
# Usar una "Contraseña de aplicación" de Google (no la contraseña de la cuenta)
# Ver: https://myaccount.google.com/apppasswords
GMAIL_USER=tu_cuenta@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
